APP_NAME=KalaKasir
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_LEVEL=debug
APP_SLOW_QUERY_MS=250

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_COOKIE=kalakasir-portal-session
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

OPS_ALERTS_TIMEOUT_SECONDS=2
PLATFORM_HEALTH_ALERT_TIMEOUT_SECONDS=1

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Prefer loopback hosts for offline localhost use.
# nip.io entries are kept as optional fallback only; they require DNS/internet.
POS_PORTAL_HOSTS=127.0.0.1,localhost,pos.127.0.0.1.nip.io
BACKOFFICE_PORTAL_HOSTS=127.0.0.1,localhost,admin.127.0.0.1.nip.io
SANCTUM_STATEFUL_DOMAINS=127.0.0.1:8000,localhost:8000,pos.127.0.0.1.nip.io:8000,admin.127.0.0.1.nip.io:8000

SECURITY_MANAGER_PIN=
ORDER_ONLINE_ADMIN_PIN=
ORDER_ONLINE_ADMIN_WHATSAPP_NUMBER=
ORDER_ONLINE_HOLD_TTL_HOURS=24
